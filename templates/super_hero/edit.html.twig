{% extends 'base.html.twig' %}

{% block title %}Modifier {{ super_hero.name }} - {{ parent() }}{% endblock %}

{% block body %}
    {{ include('components/_page_header.html.twig', {
        'title': 'Modifier ' ~ super_hero.name,
        'subtitle': 'Modifiez les informations de ce super-héros',
        'icon': 'fas fa-edit',
        'actions': [
            {'url': path('super_hero_show', {'id': super_hero.id}), 'label': 'Voir', 'icon': 'fas fa-eye', 'class': 'btn-light'},
            {'url': path('super_hero_index'), 'label': 'Retour à la liste', 'icon': 'fas fa-arrow-left', 'class': 'btn-light'}
        ]
    }) }}

    <div class="card">
        <div class="card-body">
            {{ include('super_hero/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="mt-3">
        {{ include('components/_danger_zone.html.twig', {
            'message': 'La suppression d\'un super-héros est irréversible. Toutes les données associées seront également supprimées.',
            'delete_form': 'super_hero/_delete_form.html.twig',
            'delete_form_vars': {'super_hero': super_hero}
        }) }}
    </div>
{% endblock %}
