{% extends 'base.html.twig' %}

{% block title %}Modifier {{ power.name }} - {{ parent() }}{% endblock %}

{% block body %}
    {{ include('components/_page_header.html.twig', {
        'title': 'Modifier ' ~ power.name,
        'subtitle': 'Modifiez les informations de ce pouvoir',
        'icon': 'fas fa-edit',
        'actions': [
            {'url': path('app_power_show', {'id': power.id}), 'label': 'Voir', 'icon': 'fas fa-eye', 'class': 'btn-light'},
            {'url': path('app_power_index'), 'label': 'Retour à la liste', 'icon': 'fas fa-arrow-left', 'class': 'btn-light'}
        ]
    }) }}

    <div class="card">
        <div class="card-body">
            {{ include('power/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="mt-3">
        {{ include('components/_danger_zone.html.twig', {
            'message': 'La suppression d\'un pouvoir est irréversible.',
            'delete_form': 'power/_delete_form.html.twig',
            'delete_form_vars': {'power': power}
        }) }}
    </div>
{% endblock %}
