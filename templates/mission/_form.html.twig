{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
    <div class="row">
        <div class="col-md-12 mb-3">
            {{ form_row(form.title) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            {{ form_row(form.description) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.location) }}
        </div>
        <div class="col-md-3 mb-3">
            {{ form_row(form.dangerLevel) }}
            <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i> 1 = faible, 5 = extrême
            </small>
        </div>
        <div class="col-md-3 mb-3">
            {{ form_row(form.status) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.startAt) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.endAt) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.assignedTeam) }}
            <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i> Sélectionnez l'équipe qui sera assignée à cette mission
            </small>
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.requiredPowers) }}
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_mission_index') }}" class="btn btn-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}
