{{ form_start(form) }}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-id-card"></i> Identité</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.name) }}
                {{ form_row(form.alterEgo) }}
                {{ form_row(form.imageFile) }}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-chart-line"></i> Statut</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        {{ form_widget(form.isAvailable) }}
                        {{ form_label(form.isAvailable) }}
                    </div>
                </div>

                {{ form_row(form.energyLevel) }}

                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <small>Un héros avec plus de 80% d'énergie peut être désigné comme leader d'équipe.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-book"></i> Biographie</h5>
    </div>
    <div class="card-body">
        {{ form_row(form.biography) }}
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-bolt"></i> Pouvoirs</h5>
    </div>
    <div class="card-body">
        {{ form_row(form.powers) }}
    </div>
</div>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary btn-lg">
        <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
    </button>
    <a href="{{ path('super_hero_index') }}" class="btn btn-secondary btn-lg">
        <i class="fas fa-times"></i> Annuler
    </a>
</div>

{{ form_end(form) }}
