{# 
    Composant d'état vide réutilisable
    
    Paramètres:
    - icon: Icône Font Awesome
    - title: Titre du message
    - message: Message descriptif
    - action_url: URL pour le bouton d'action (optionnel)
    - action_label: Label du bouton d'action (optionnel)
    - action_icon: Icône du bouton d'action (optionnel)
#}
<div class="alert alert-info text-center">
    <i class="{{ icon }} fa-3x mb-3"></i>
    <h4>{{ title }}</h4>
    {% if message is defined and message %}
        <p>{{ message }}</p>
    {% endif %}
    {% if action_url is defined and action_url %}
        <a href="{{ action_url }}" class="btn btn-primary">
            {% if action_icon is defined and action_icon %}
                <i class="{{ action_icon }}"></i>
            {% endif %}
            {{ action_label|default('Ajouter') }}
        </a>
    {% endif %}
</div>

