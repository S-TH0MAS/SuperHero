<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}S.H.I.E.L.D 2.0{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        {# Les styles personnalisés sont compilés par Webpack Encore depuis assets/styles/app.scss #}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="fas fa-shield-alt"></i> S.H.I.E.L.D 2.0
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">
                        <i class="fas fa-home"></i> Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('super_hero_index') }}">
                        <i class="fas fa-mask"></i> Héros
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_power_index') }}">
                        <i class="fas fa-bolt"></i> Pouvoirs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_team_index') }}">
                        <i class="fas fa-users"></i> Équipes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_mission_index') }}">
                        <i class="fas fa-clipboard-list"></i> Missions
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container main-container animate-in">
    {% for type, messages in app.flashes %}
        {% set alertClass = {
            'success': 'success',
            'error': 'danger',
            'warning': 'warning',
            'info': 'info'
        } %}
        {% for message in messages %}
            <div class="alert alert-{{ alertClass[type]|default('info') }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div>
                <h5 class="mb-2">
                    <i class="fas fa-shield-alt"></i> S.H.I.E.L.D 2.0
                </h5>
                <p class="mb-0">
                    Strategic Homeland Intervention, Enforcement and Logistics Division
                </p>
                <p class="mb-0 mt-2">
                    <small>Protéger le monde des menaces extraordinaires</small>
                </p>
            </div>
            <div class="footer-links">
                <a href="{{ path('app_home') }}">
                    <i class="fas fa-home"></i> Accueil
                </a>
                <a href="{{ path('super_hero_index') }}">
                    <i class="fas fa-mask"></i> Héros
                </a>
                <a href="{{ path('app_power_index') }}">
                    <i class="fas fa-bolt"></i> Pouvoirs
                </a>
                <a href="{{ path('app_team_index') }}">
                    <i class="fas fa-users"></i> Équipes
                </a>
                <a href="{{ path('app_mission_index') }}">
                    <i class="fas fa-clipboard-list"></i> Missions
                </a>
            </div>
            <div class="text-end">
                <p class="mb-0">
                    &copy; {{ 'now'|date('Y') }} S.H.I.E.L.D 2.0
                </p>
                <p class="mb-0 mt-2">
                    <small>Tous droits réservés</small>
                </p>
            </div>
        </div>
    </div>
</footer>

{% block javascripts %}
    {# Webpack Encore pour la compilation du JavaScript #}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
