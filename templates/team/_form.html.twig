{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
    <div class="row">
        <div class="col-md-12 mb-3">
            {{ form_row(form.name) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.leader) }}
            <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i> Le leader doit avoir un niveau d'énergie supérieur à 80%
            </small>
        </div>
        <div class="col-md-6 mb-3">
            <div class="form-check form-switch mb-3">
                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            {{ form_row(form.members) }}
            <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i> Maintenez Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs membres. Une équipe doit avoir entre 2 et 5 membres.
            </small>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_team_index') }}" class="btn btn-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}
