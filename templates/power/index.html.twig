{% extends 'base.html.twig' %}

{% block title %}Liste des Pouvoirs - {{ parent() }}{% endblock %}

{% block body %}
    {{ include('components/_page_header.html.twig', {
        'title': 'Pouvoirs',
        'subtitle': 'Gestion des pouvoirs surhumains',
        'icon': 'fas fa-bolt',
        'actions': [{
            'url': path('app_power_new'),
            'label': 'Nouveau Pouvoir',
            'icon': 'fas fa-plus-circle',
            'class': 'btn-light',
            'size': 'btn-lg'
        }]
    }) }}

    {% if powers is empty %}
        {{ include('components/_empty_state.html.twig', {
            'icon': 'fas fa-bolt',
            'title': 'Aucun pouvoir trouvé',
            'message': 'Commencez par ajouter votre premier pouvoir !',
            'action_url': path('app_power_new'),
            'action_label': 'Ajouter un Pouvoir',
            'action_icon': 'fas fa-plus-circle'
        }) }}
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for power in powers %}
                {{ include('components/_power_card.html.twig', {'power': power}) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
