{% extends 'base.html.twig' %}

{% block title %}Liste des Équipes - {{ parent() }}{% endblock %}

{% block body %}
    {{ include('components/_page_header.html.twig', {
        'title': 'Équipes',
        'subtitle': 'Gestion des équipes de super-héros',
        'icon': 'fas fa-users',
        'actions': [{
            'url': path('app_team_new'),
            'label': 'Nouvelle Équipe',
            'icon': 'fas fa-plus-circle',
            'class': 'btn-light',
            'size': 'btn-lg'
        }]
    }) }}

    {% if teams is empty %}
        {{ include('components/_empty_state.html.twig', {
            'icon': 'fas fa-users',
            'title': 'Aucune équipe trouvée',
            'message': 'Commencez par créer votre première équipe !',
            'action_url': path('app_team_new'),
            'action_label': 'Créer une Équipe',
            'action_icon': 'fas fa-plus-circle'
        }) }}
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for team in teams %}
                {{ include('components/_team_card.html.twig', {'team': team}) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
